[Unit]
Description=Clock-in Device A7 kiosk
After=weston-graphical-session.service wpa_supplicant@wlan0.service udhcpc-wlan0.service
Wants=weston-graphical-session.service wpa_supplicant@wlan0.service udhcpc-wlan0.service
ConditionKernelCommandLine=systemd.mask=m4-autostart.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/lib/clockin-device
EnvironmentFile=/etc/clockin-device/environment
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStartPre=/bin/sh -c 'i=0; until test -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY"; do i=$((i + 1)); test "$i" -ge 60 && { echo "Wayland socket did not become ready" >&2; exit 1; }; sleep 1; done'
ExecStart=/usr/local/bin/clockin-device
ExecStopPost=/usr/local/lib/clockin-device/disable-buzzer.sh
Restart=always
RestartSec=5
# The application finishes or force-exits within 3 s of SIGTERM.
TimeoutStopSec=5
UMask=0077
RuntimeDirectory=clockin-device
RuntimeDirectoryMode=0700
SyslogIdentifier=clockin-device
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
